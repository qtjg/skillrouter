{
  "name": "skillrouter",
  "version": "0.1.0",
  "description": "The capability router for AI agents. Give your AI the right capabilities at the right time.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "skillrouter": "./bin/skillrouter.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "schemas",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"tests/unit/*.test.ts\" \"tests/router/*.test.ts\"",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:router": "node --experimental-strip-types --test \"tests/router/*.test.ts\"",
    "test:security": "node --test tests/security/",
    "test:adapters": "node --test tests/adapters/",
    "benchmark": "node --test tests/benchmark/",
    "doctor": "node src/cli/index.ts doctor"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "mcp",
    "router",
    "capabilities",
    "cli",
    "opencode",
    "gemini",
    "claude"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}